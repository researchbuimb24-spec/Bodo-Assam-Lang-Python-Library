# Databases and archives
*.zip
*.sqlite
*.db

# Data archive directories
data/archive/*/books/
data/archive/*/folk_songs/
data/archive/*/datasets/

# Keep culture and history markdown files tracked
!data/archive/*/culture/*.md
!data/archive/*/history/*.md

# Python caches, environments, and build artifacts
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Testing & Linting
.pytest_cache
.ruff_cache
.coverage
htmlcov/
